{
    "identity": "SMM360 VIP Care",
    "version": "0.0.1",
    "module": "Reception",
    "fileName": "reception-config.json",
    "description": "پیکربندی مرکزی ماژول پذیرش",
    "config": {
        "module": {
            "name": "Reception",
            "displayName": "پذیرش",
            "version": "0.0.1",
            "enabled": true
        },
        "general": {
            "locale": "fa-IR",
            "calendar": "persian",
            "timezone": "Asia/Tehran",
            "dateFormat": "YYYY/MM/DD",
            "timeFormat": "HH:mm",
            "firstDayOfWeek": 6
        },
        "healthSeeker": {
            "entityName": "HealthSeeker",
            "displayName": "سلامتجو",
            "identifier": {
                "prefix": "SMM360",
                "separator": "-",
                "year": {
                    "calendar": "persian",
                    "format": "YY",
                    "length": 2
                },
                "month": {
                    "calendar": "persian",
                    "format": "MM",
                    "length": 2
                },
                "sequence": {
                    "length": 3,
                    "start": 1,
                    "monthlyReset": true,
                    "zeroPadding": true
                },
                "format": "SMM360-YY-MM-SSS",
                "example": "SMM360-05-04-001"
            },
            "privacy": {
                "nationalId": false,
                "nationalCode": false,
                "identityDocuments": false
            },
            "status": {
                "default": "ACTIVE",
                "values": [
                    "ACTIVE",
                    "INACTIVE",
                    "ARCHIVED"
                ]
            }
        },
        "visit": {
            "entityName": "Visit",
            "displayName": "ویزیت",
            "identifier": {
                "baseIdentifier": "healthSeekerId",
                "suffixPrefix": "V",
                "sequence": {
                    "length": 2,
                    "start": 1,
                    "incrementPerVisit": true,
                    "zeroPadding": true
                },
                "format": "HEALTH_SEEKER_ID-VNN",
                "examples": [
                    "SMM360-05-04-001-V01",
                    "SMM360-05-04-001-V02",
                    "SMM360-05-04-001-V03"
                ]
            },
            "sequence": {
                "scope": "healthSeeker",
                "reset": false,
                "incrementOnNewVisit": true
            }
        }
    }
}

